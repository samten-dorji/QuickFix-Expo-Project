{
    "expo":  {
                 "name":  "Quick Fix",
                 "slug":  "QuickFixProjectII",
                 "version":  "1.0.0",
                 "orientation":  "portrait",
                 "icon":  "./assets/images/quickfix-icon.png",
                 "scheme":  "quickfixprojectii",
                 "userInterfaceStyle":  "light",
                 "ios":  {
                             "icon":  "./assets/images/quickfix-icon.png"
                         },
                 "android":  {
                                 "adaptiveIcon":  {
                                                      "backgroundColor":  "#045c5a",
                                                      "foregroundImage":  "./assets/images/quickfix-adaptive-foreground.png",
                                                      "monochromeImage":  "./assets/images/quickfix-adaptive-monochrome.png"
                                                  },
                                 "predictiveBackGestureEnabled":  false
                             },
                 "web":  {
                             "output":  "server",
                             "favicon":  "./assets/images/quickfix-favicon.png"
                         },
                 "plugins":  [
                                 "expo-router",
                                 [
                                     "expo-splash-screen",
                                     {
                                         "backgroundColor":  "#f8f9fb",
                                         "image":  "./assets/images/quickfix-splash.png",
                                         "imageWidth":  128,
                                         "resizeMode":  "contain"
                                     }
                                 ],
                                 [
                                     "expo-image-picker",
                                     {
                                         "cameraPermission":  "Allow Quick Fix to photograph maintenance issues.",
                                         "photosPermission":  "Allow Quick Fix to select maintenance evidence photos.",
                                         "microphonePermission":  false
                                     }
                                 ]
                             ],
                 "experiments":  {
                                     "typedRoutes":  true,
                                     "reactCompiler":  true
                                 }
             }
}